# Dongri-grigri local server defaults
PORT=8790
HOST=127.0.0.1

# Required: encrypt OAuth + messenger channel tokens stored in SQLite.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_SECRET="__CHANGE_ME__"

# Optional legacy fallback for OAUTH_ENCRYPTION_SECRET
# SESSION_SECRET="__CHANGE_ME__"

# Optional runtime paths (defaults: ./claw-empire.sqlite and ./logs for local node runs)
# DB_PATH="./claw-empire.sqlite"
# LOGS_DIR="./logs"

# Docker Compose host runtime root. Keep DB/logs/OAuth accounts/worktrees outside the source repo.
# Default compose value: ../runtime/DonggriCompany
# DONGGRI_RUNTIME_ROOT="C:\\path\\to\\donggri-runtime\\DonggriCompany"

# Isolated task worktree base used inside the runtime container.
# WORKTREE_BASE_DIR="/runtime/worktrees/DonggriCompany"

# Optional callback base URL override
# OAUTH_BASE_URL="http://127.0.0.1:8790"

# API auth token (default office password)
API_AUTH_TOKEN="__CHANGE_ME__"

# Office runner isolation (provider+accountPool Docker runner)
# OFFICE_RUNNER_DOCKER_ENABLED=0
# OFFICE_RUNNER_IMAGE="donggricompany-runner:latest"
# OFFICE_RUNNER_MAX_ACTIVE=5
# OFFICE_RUNNER_IDLE_TTL_MS=900000
# OFFICE_RUNNER_NETWORK="bridge"

# Remote browser clients provide API_AUTH_TOKEN at runtime.
# It is not embedded in frontend build artifacts.

# Optional extra trusted origins/suffixes for CORS
# ALLOWED_ORIGINS="https://claw.example.com"
# ALLOWED_ORIGIN_SUFFIXES=".ts.net,.example.com"

# GitHub OAuth (Settings -> Developer settings -> OAuth Apps)
# OAUTH_GITHUB_CLIENT_ID="__CHANGE_ME__"
# OAUTH_GITHUB_CLIENT_SECRET="__CHANGE_ME__"

# Google OAuth (Google Cloud Console -> OAuth consent screen)
# OAUTH_GOOGLE_CLIENT_ID="__CHANGE_ME__"
# OAUTH_GOOGLE_CLIENT_SECRET="__CHANGE_ME__"

# Gmail intake receiver ([DonggriCompany] mail -> PRN approval queue)
# GMAIL_INTAKE_ENABLED=0
# GMAIL_INTAKE_SUBJECT_TOKEN="[DonggriCompany]"
# GMAIL_INTAKE_ALLOWED_SENDERS="your@email.com"
# GMAIL_INTAKE_POLL_INTERVAL_MS=60000
# GMAIL_INTAKE_LOOKBACK_DAYS=14
# GMAIL_INTAKE_MAX_ATTACHMENT_MB=10
# GMAIL_INTAKE_TELEGRAM_SESSION_KEY="telegram:global"
# GMAIL_INTAKE_DEFAULT_PROJECT_PATH="C:\\path\\to\\DonggriCompany"
# Optional dedicated OAuth client values. Falls back to OAUTH_GOOGLE_CLIENT_ID/SECRET.
# GMAIL_INTAKE_GOOGLE_CLIENT_ID="__CHANGE_ME__"
# GMAIL_INTAKE_GOOGLE_CLIENT_SECRET="__CHANGE_ME__"

# Google Calendar intake receiver (Calendar event -> PRN approval queue)
# CALENDAR_INTAKE_ENABLED=0
# CALENDAR_INTAKE_CALENDAR_ID="primary"
# CALENDAR_INTAKE_MATCH_TOKENS="[DonggriCompany],[Hackathon],[해커톤],해커톤,hackathon"
# CALENDAR_INTAKE_POLL_INTERVAL_MS=60000
# CALENDAR_INTAKE_LOOKBACK_DAYS=1
# CALENDAR_INTAKE_LOOKAHEAD_DAYS=60
# CALENDAR_INTAKE_TELEGRAM_SESSION_KEY="telegram:global"
# CALENDAR_INTAKE_DEFAULT_PROJECT_PATH="C:\\path\\to\\DonggriCompany"

# Optional explicit Gemini OAuth credentials
# GEMINI_OAUTH_CLIENT_ID="__CHANGE_ME__"
# GEMINI_OAUTH_CLIENT_SECRET="__CHANGE_ME__"

# Optional model provider settings
# OPENAI_API_KEY="__CHANGE_ME__"
# GOOGLE_CLOUD_PROJECT="__CHANGE_ME__"
# GOOGLE_CLOUD_PROJECT_ID="__CHANGE_ME__"

# Messenger channel tokens/sessions are managed in UI Settings.
# Optional send-only Telegram department bots. Receiver polling still uses only telegram:global.
# TELEGRAM_DEPARTMENT_BOT_ROUTING=0
# TELEGRAM_GLOBAL_GROUP_CHAT_ID="-100..."
# TELEGRAM_BOT_TOKEN_DEV="__CHANGE_ME__"
# TELEGRAM_BOT_TOKEN_QA="__CHANGE_ME__"
# TELEGRAM_BOT_TOKEN_DESIGN="__CHANGE_ME__"
# TELEGRAM_BOT_TOKEN_PLANNING="__CHANGE_ME__"
# TELEGRAM_BOT_TOKEN_PMO="__CHANGE_ME__"
# TELEGRAM_BOT_TOKEN_CEO_PMO="__CHANGE_ME__"
# TELEGRAM_BOT_TOKEN_PM="__CHANGE_ME__"
# TELEGRAM_BOT_TOKEN_OPERATIONS="__CHANGE_ME__"
# TELEGRAM_BOT_TOKEN_DEVSECOPS="__CHANGE_ME__"

# Required for /api/inbox webhook endpoint (sent via x-inbox-secret header)
# INBOX_WEBHOOK_SECRET=__CHANGE_ME__

# Optional meeting prompt budget tuning
# MEETING_PROMPT_TASK_CONTEXT_MAX_CHARS=1200
# MEETING_TRANSCRIPT_MAX_TURNS=20
# MEETING_TRANSCRIPT_LINE_MAX_CHARS=180
# MEETING_TRANSCRIPT_TOTAL_MAX_CHARS=2400
# REVIEW_MEETING_ONESHOT_TIMEOUT_MS=65000
# Milliseconds. (Backward compatibility: values <= 600 are treated as seconds.)

# Internal one-time migration marker (auto-managed by v1.0.5 runtime migration)
# CLAW_MIGRATION_V1_0_5_DONE=1
# Optional absolute local root projected by the Dongri-grigri Control Plane dashboard.
# A standalone public clone can omit this and run with a safely degraded local projection.
DONGGRI_CONTROL_ROOT=
