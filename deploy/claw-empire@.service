[Unit]
Description=DonggriCompany service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/DonggriCompany
EnvironmentFile=-%h/DonggriCompany/deploy/.env.production
ExecStartPre=/usr/bin/env bash -lc 'mkdir -p %h/DonggriCompany/logs'
ExecStart=/usr/bin/env bash -lc 'cd %h/DonggriCompany && corepack pnpm run start'
Restart=on-failure
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:%h/DonggriCompany/logs/donggricompany.log
StandardError=append:%h/DonggriCompany/logs/donggricompany.err
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
